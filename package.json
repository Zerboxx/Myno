{
  "name": "roblox-ai-studio",
  "version": "0.2.0",
  "description": "Local AI Development Agent for Roblox Studio — build, script, UI, NPC/AI, and live-verify Roblox content through Studio MCP with persistent project memory",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "desktop:preload": "esbuild src/desktop/electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/desktop/electron/preload.cjs",
    "desktop:build": "tsc -p tsconfig.desktop.json && npm run desktop:preload",
    "desktop:start": "npm run desktop:build && electron ./dist/desktop/electron/entry.js",
    "smoke:groq": "tsx scripts/smoke-groq.ts",
    "smoke:efficiency": "tsx scripts/smoke-efficiency.ts"
  },
  "keywords": [
    "roblox",
    "ai",
    "agent",
    "ollama",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^20.13.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
