# Copy this file to .env and adjust as needed.

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: Roblox Studio MCP custom launcher (instead of the default
# %LOCALAPPDATA%\Roblox\mcp.bat plugin launcher).
# ROBUX_MCP_COMMAND=
# ROBUX_MCP_ARGS=

# Optional: persistent memory settings (defaults shown).
# MEMORY_FILE=data/memory.json
# MEMORY_MAX_ENTRIES=500

# NOTE: DEFAULT_CHAT_MODEL / DEFAULT_CODE_MODEL are legacy values.
# The code does not read them at runtime — the active model configuration
# lives in config/models.json.
DEFAULT_CHAT_MODEL=qwen2.5-coder-32k:latest
DEFAULT_CODE_MODEL=qwen2.5-coder-32k:latest